<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/margin_small"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation_elevated"
    app:cardBackgroundColor="@color/teal_200" >
    <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="@dimen/padding_small"
    android:paddingBottom="@dimen/padding_small"
    android:paddingHorizontal="@dimen/padding_medium">

    <TextView
        android:id="@+id/tvPagoNumero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:textColor="?attr/colorPrimary"
        tools:text="1" /> <TextView
    android:id="@+id/tvPagoMonto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="@dimen/text_size_medium_title"
    android:textStyle="bold"
    android:textColor="@color/black"
    android:layout_marginTop="@dimen/margin_small"
    tools:text="100" /> <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="@color/colorSurfaceVariant"
    android:layout_marginTop="@dimen/margin_small"
    android:layout_marginBottom="@dimen/margin_small"/>

    <TextView
        android:id="@+id/tvPagoFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_size_small"
        android:textColor="@color/black"
        tools:text="03-04-21" />

</LinearLayout>
</com.google.android.material.card.MaterialCardView>
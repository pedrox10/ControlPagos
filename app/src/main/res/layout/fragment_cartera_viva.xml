<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cartera Viva"
        android:gravity="center"
        android:textSize="@dimen/text_size_large_title"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="10dp" />

    <!-- Cards de resumen — total + morosos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <!-- Card: total en calle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorBackgroundCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total en calle"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvTotalCartera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs 0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvTotalClientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 clientes con saldo"
                    android:textSize="11sp"
                    android:textColor="@color/colorSuccess"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: morosos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorBackgroundCard"
            app:strokeColor="@color/colorDanger"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Morosos"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvTotalMorosos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bs 0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorDanger"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvCantidadMorosos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 clientes morosos"
                    android:textSize="11sp"
                    android:textColor="@color/colorDanger"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Header tabla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorHeaderTabla"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.8"
            android:layout_height="wrap_content"
            android:text="Cliente"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_height="wrap_content"
            android:text="Sector"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="wrap_content"
            android:text="Ped."
            android:textSize="12sp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.9"
            android:layout_height="wrap_content"
            android:text="Saldo"
            android:textSize="12sp"
            android:gravity="end"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />
    </LinearLayout>

    <!-- Lista -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCartera"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Pie con total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorHeaderTabla"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="TOTAL CARTERA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />

        <TextView
            android:id="@+id/tvTotalCarteraPie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bs 0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorDanger" />

    </LinearLayout>

</LinearLayout>
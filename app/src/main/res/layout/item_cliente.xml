<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:background="@color/colorBackgroundCard"
        >
        <TextView
            android:id="@+id/tvNumeroCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_body_bold"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginEnd="16dp"
            tools:text="1." />


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body_bold"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                tools:text="Andrea Gómez" />

            <TextView
                android:id="@+id/tvClienteRubro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body_regular"
                android:textColor="@android:color/darker_gray"
                tools:text="Venta de zumo" />

            <TextView
                android:id="@+id/tvClienteTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_body_regular"
                android:textColor="@android:color/darker_gray"
                tools:text="Teléfono: 74030040" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvClienteGrupo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="@dimen/text_size_body_regular"
                    tools:text="Grupo: Calatayud" />
                <TextView
                    android:id="@+id/tvStamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stamp_red"
                    android:text="SIN SALDO"
                    android:textColor="#D32F2F"
                    android:textStyle="bold"
                    android:textSize="8sp"
                android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsApp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/teal_200"
                android:contentDescription="Abrir WhatsApp"
                android:padding="5dp"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_android"
                app:iconGravity="textTop"
                app:iconSize="30dp"
                app:iconTint="@color/teal_700" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPagoHoy"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:visibility="visible"
                android:backgroundTint="@color/fondoResaltado"
                android:contentDescription="Info Pago"
                app:icon="@drawable/price_check_24px"
                app:iconGravity="textTop"
                app:iconSize="24dp"
                app:iconTint="@color/colorResaltado" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
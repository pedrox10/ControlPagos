<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REPORTE DE PAGOS"
            android:gravity="center"
            android:textSize="@dimen/text_size_large_title"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvRangoFechas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvTotalGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total General: 0 Bs"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/layoutTotalesCobradores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorHeaderTabla"
        android:padding="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.9"
            android:layout_height="wrap_content"
            android:text="Fecha"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1.65"
            android:layout_height="wrap_content"
            android:text="Cliente"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="wrap_content"
            android:text="Monto"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="0.85"
            android:layout_height="wrap_content"
            android:text="Cobrador"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/colorHeaderTablaTexto" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReportePagos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
